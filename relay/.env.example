# Copie ce fichier en « .env » sur la machine qui héberge le relais, puis renseigne la clé.
# Le fichier .env ne doit jamais être partagé ni ajouté à un dépôt Git.

# Clé d'API NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=

# Facultatif
# PORT=8787
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# RATE_PER_IP_PER_HOUR=10
# RATE_GLOBAL_PER_DAY=500
